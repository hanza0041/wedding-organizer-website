# Copy to .env. No dependencies or npm install required. Node.js 24+.
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/wedding.sqlite

# Recommended fixed URL: create a remotely-managed Cloudflare Tunnel,
# set its published hostname to http://localhost:3001, then paste its token.
# For the optional Docker Compose tunnel profile, use http://app:3001 instead.
# Keep this value private. .env is ignored by Git.
CLOUDFLARE_TUNNEL_TOKEN=

# Alternative: locally-managed named tunnel (make tunnel-config).
TUNNEL_NAME=our-wedding
TUNNEL_ID=
TUNNEL_HOSTNAME=wedding.example.com
TUNNEL_CREDENTIALS=
CF_CONFIG=./.cloudflared/config.yml
